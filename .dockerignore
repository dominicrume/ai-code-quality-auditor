# flyctl launch added from .gitignore
# Secrets
**/.env
**/*.env
!**/.env.example

# Experiment data (regeneratable, not version-controlled)
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
# data/reports/ is intentionally INCLUDED so the hosted dashboard renders.
!**/data/reports/.gitkeep

# Python
**/__pycache__
**/*.pyc
**/.venv
**/*.egg-info
**/build
**/dist
**/.pytest_cache

# OS / Editor
**/.DS_Store
**/.vscode/*
!**/.vscode/extensions.json

# flyctl launch added from .pytest_cache/.gitignore
# Created by pytest automatically.
.pytest_cache/**/*

# flyctl launch added from data/raw/run_002/cursor_agent/code/.pytest_cache/.gitignore
# Created by pytest automatically.
data/raw/run_002/cursor_agent/code/.pytest_cache/**/*

# flyctl launch added from data/raw/run_002/cursor_agent/code/.venv/.gitignore
# Created by venv; see https://docs.python.org/3/library/venv.html
data/raw/run_002/cursor_agent/code/.venv/**/*
fly.toml

# Moved-aside or rebuilt virtualenvs (the pattern above only matches ".venv"),
# and the untracked pilot archive, neither of which the dashboard needs
**/.venv*
data/archive
# Rater sheets and labelling packs, including pack_002 ground truth
data/labels
