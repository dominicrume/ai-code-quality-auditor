# Secrets
.env
*.env
!.env.example

# Experiment data (regeneratable, not version-controlled)
data/raw/*
data/processed/*
data/reports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/

# OS / Editor
.DS_Store
.vscode/*
!.vscode/extensions.json
replay_dirs/
data/waitlist.jsonl

# Local tool state produced by running the auditor on this repo itself.
.auditor/

# Scratch output from demo runs; contains absolute paths.
test_output.json

# Evidence images are large binaries; the captions and builder are tracked.
evidence/*.png
evidence/*.jpg
evidence/*.jpeg
evidence/.DS_Store
evidence/prepared/

# Rebuilt or moved-aside virtualenvs (e.g. .venv.x86_64-broken-*)
.venv*/
